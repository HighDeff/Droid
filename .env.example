# Public Builder configuration used by the client build.
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# Optional health-check response message.
PING_MESSAGE="ping pong"

# Production API protection. Generate a long random value and send it as
# X-API-Key or Authorization: Bearer <value>. In development, requests from
# loopback are allowed only when this value is unset.
ASSISTANT_API_KEY=
# Comma-separated browser origins allowed to call the API. Empty means no CORS.
CORS_ORIGINS=
# The server binds to loopback by default. Set HOST/DEV_HOST explicitly only
# when a reverse proxy and authentication protect the service.
HOST=127.0.0.1
DEV_HOST=127.0.0.1

# Optional OCR integrations. If set, the remote provider is tried before local Tesseract.
OCR_REMOTE_URL=
OCR_REMOTE_API_KEY=
# Timeout shared by remote OCR and the fixed `tesseract` executable.
OCR_TIMEOUT_MS=8000

# Assistant state storage. Durable JSON storage is the default.
# Set to "memory" only when persistence is intentionally disabled.
ASSISTANT_STORAGE_MODE=durable
ASSISTANT_STORAGE_PATH=./data/assistant-state.json

# Device adapters are disabled by default. Enable each capability deliberately.
AUTOMATION_ADAPTERS_ENABLED=false
DESKTOP_AUTOMATION_ENABLED=false
ANDROID_AUTOMATION_ENABLED=false
CAPTURE_ADAPTERS_ENABLED=false
