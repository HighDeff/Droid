# Public Builder configuration used by the client build.
VITE_PUBLIC_BUILDER_KEY=__BUILDER_PUBLIC_KEY__

# Optional health-check response message.
PING_MESSAGE="ping pong"

# Optional OCR integrations. If set, the remote provider is tried before local Tesseract.
OCR_REMOTE_URL=
OCR_REMOTE_API_KEY=
# Timeout shared by remote OCR and the fixed `tesseract` executable.
OCR_TIMEOUT_MS=8000

# Assistant state storage. Durable JSON storage is the default.
# Set to "memory" only when persistence is intentionally disabled.
ASSISTANT_STORAGE_MODE=durable
ASSISTANT_STORAGE_PATH=./data/assistant-state.json
